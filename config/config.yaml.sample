# config.yaml - 书签管理配置示例

# ==================
# 个人上下文
# ==================
profile: |
  在此描述你的技术背景和兴趣方向，AI 会参考此信息打标签。
  例如：全栈开发，主要方向是前端和后端，技术栈涵盖 React、Node.js、Python。

# ==================
# 标签定义
# ==================
tags:

  # 领域标签（每条书签必须有 1 个，对应一级分类）
  domain:
    - 前端
    - 后端
    - AI
    - DevOps
    - 编程基础
    - 资源
    - 待分类

  # 技术关键词标签（每条书签 1-3 个）
  tech:
    - React
    - Vue
    - TypeScript
    - Python
    - Docker
    - Git
    - 算法

  # 内容类型标签（可选 0-1 个）
  type:
    - 教程
    - 文档
    - 源码

  # 场景来源标签（可选 0-2 个）
  meta:
    - 博客
    - 求职

  # 状态标签（可选 0-2 个）
  status:
    - 过时
    - 精华

# ==================
# 分类映射规则
# ==================
# 同阶段内优先级从上到下，首条匹配生效
classification_rules:
  # Pre-AI 规则（url_contains / title_contains）
  - domain: 资源
    match:
      url_contains: ["notion.so", "figma.com"]

  # Post-AI 规则（tag_contains）
  - domain: 前端
    match:
      tag_contains: ["React", "Vue", "TypeScript"]

  - domain: AI
    match:
      tag_contains: ["LLM"]

  # 兜底
  - domain: 待分类
    match:
      default: true
