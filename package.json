{
  "name": "bookmark-prune",
  "version": "0.1.0",
  "description": "Bookmark pruning CLI — dead link detection, AI tagging, auto classification",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bm": "dist/index.js"
  },
  "scripts": {
    "dev": "trap 'kill 0' EXIT; tsx --watch src/index.ts ui & until curl -sf http://localhost:3000/api/stats >/dev/null; do sleep 0.5; done && npx vite & wait",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "bookmark",
    "prune",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "jsdom": "^29.0.2",
    "node-html-parser": "^7.1.0",
    "uuid": "^14.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
